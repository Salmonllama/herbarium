# === Herbarium Production Environment ===
APP_NAME=Herbarium
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Instance Mode
APP_REGISTRATION_MODE=invite_only
APP_DEFAULT_HERBARIUM=

# Ports (used by Caddy)
HTTP_PORT=80
HTTPS_PORT=443

# Database (PostgreSQL + PostGIS)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=herbarium
DB_USERNAME=herbarium
DB_PASSWORD=change-this-strong-password

# Cache, Session & Queues (Redis)
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# Sanctum Stateful Domains (comma-separated, include your domain)
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Search (database = built-in Postgres pg_trgm/tsvector; meilisearch = optional profile)
SCOUT_DRIVER=database
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=

# Media Storage (local or s3)
HERBARIUM_MEDIA_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mail (SMTP)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@herbarium.local
MAIL_FROM_NAME="${APP_NAME}"

# Optional Institutional Identity Providers (ORCID & Generic OIDC)
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI="${APP_URL}/auth/orcid/callback"
ORCID_SANDBOX=false

OIDC_ENABLED=false
OIDC_LABEL="Institution SSO"
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI="${APP_URL}/auth/oidc/callback"
